<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
	    <GeneratePackageOnBuild Condition="'$(GeneratePackageOnBuild)' == '' and '$(Configuration)' != 'Debug'">True</GeneratePackageOnBuild>
        <Description>Azure Blob Storage-backed checkpoint and workflow persistence for Reimaginate's Microsoft Agent Framework-based workflow layer.</Description>
        <PackageTags>orchestrator;workflow;azure;storage</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Reimaginate.Orchestrator.Abstractions\Reimaginate.Orchestrator.Abstractions.csproj" />
      <ProjectReference Include="..\Reimaginate.Orchestrator.Common\Reimaginate.Orchestrator.Common.csproj" />
    </ItemGroup>

</Project>
