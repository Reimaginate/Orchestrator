<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild Condition="'$(GeneratePackageOnBuild)' == '' and '$(Configuration)' != 'Debug'">True</GeneratePackageOnBuild>
        <Description>Reusable CLI commands and host composition for Reimaginate's Microsoft Agent Framework-based workflow layer.</Description>
        <PackageTags>orchestrator;workflow;cli;hosting</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Reimaginate.CLI.Base" Version="1.0.2" />
        <PackageReference Include="Reimaginate.Mediator.Abstractions" Version="1.3.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Reimaginate.Orchestrator.Common\Reimaginate.Orchestrator.Common.csproj" SkipGetTargetFrameworkProperties="true" />
    </ItemGroup>

</Project>
